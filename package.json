{
  "name": "gridwise",
  "version": "1.3.0",
  "private": true,
  "description": "Passive PvE combat assistant overlay for EVE Online",
  "author": "Martin Kummer",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev -- --ozone-platform=x11",
    "dev:wayland": "electron-vite dev -- --ozone-platform=wayland",
    "build": "electron-vite build",
    "start": "electron-vite preview -- --ozone-platform=x11",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "replay": "tsx src/cli/replay.ts",
    "fixture": "tsx src/cli/fixture.ts",
    "e2e": "electron-vite build && playwright test --project e2e",
    "screenshots": "electron-vite build && playwright test --project screenshots",
    "docs:images": "node scripts/docs-images.mjs",
    "inspect": "tsx src/cli/inspect.ts",
    "sde": "tsx src/cli/sde.ts",
    "fit": "tsx src/cli/fit.ts",
    "kb": "tsx src/cli/kb.ts",
    "icons": "node scripts/copy-brackets.mjs",
    "icons:app": "magick -background none resources/icon.svg -depth 8 resources/icon-512.png && magick -background none resources/icon.svg -resize 64x64 -depth 8 resources/icon@2x.png && magick -background none resources/icon.svg -resize 32x32 -depth 8 resources/icon.png && magick -background none resources/icon.svg -depth 8 -define icon:auto-resize=256,128,64,48,32,16 resources/icon.ico",
    "data:build": "npm run sde -- update --db data/sde.sqlite && npm run kb -- import-wiki && npm run kb -- import-sitemap && npm run kb -- import-abyss",
    "dist": "electron-vite build && electron-builder --linux AppImage",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:win-zip": "electron-vite build && electron-builder --win zip"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "electron-updater": "^6.8.11",
    "eve-fit-engine": "0.2.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yazl": "^3.3.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@44.9.1": true,
    "electron-winstaller": false
  },
  "homepage": "https://github.com/Incaseof-dev/Gridwise",
  "desktopName": "gridwise.desktop"
}
